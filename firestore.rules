rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CCAR-F ownership, read from the ID token only. The enrolled claim keeps
    // granting CCAR-F forever; products.ccar is the additive claim the CCDV-F
    // work introduces (second-product recon, 12 Oct 2026). get() with a default
    // is used so a token without either key evaluates to false, never to an
    // error that would deny an enrolled user.
    function ownsCcar() {
      return request.auth != null
        && (request.auth.token.get('enrolled', false) == true
            || request.auth.token.get('products', {}).get('ccar', false) == true);
    }

    match /users/{userId} {
      // Only the Stripe webhook and the ops scripts (Admin SDK, which bypasses
      // these rules) may write the entitlement fields. A signed-in user may
      // create and update their own document, but never add or change them.
      function isOwner() { return request.auth != null && request.auth.uid == userId; }
      // firstBuyClickAt and the abandoner map are written only by the webhook
      // (checkout-abandoner emails, freeze exception 10, Build Schedule row 576).
      function serverOwned() { return ['enrolled', 'enrolledAt', 'stripeSessionId', 'firstBuyClickAt', 'abandoner']; }

      allow read: if isOwner();
      allow create: if isOwner()
                    && !request.resource.data.keys().hasAny(serverOwned());
      allow update: if isOwner()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwned());
      allow delete: if false;

      match /attempts/{attemptId} {
        allow read, write: if isOwner();
      }
    }

    // The paid CCAR-F question bank (one document per domain) and the paid
    // lessons (one document per module). Written only by the Admin SDK upload
    // script in the private cca-question-banks repository. Readable by an
    // account that owns CCAR-F; no client may write.
    match /bank_ccar/{domainId} {
      allow read: if ownsCcar();
      allow write: if false;
    }
    match /lessons_ccar/{lessonId} {
      allow read: if ownsCcar();
      allow write: if false;
    }
  }
}
